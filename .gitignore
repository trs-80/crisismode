# Dependencies
node_modules/
vendor/
.pnpm-store/

# Build output
# dist/ is intentionally unanchored — packages/*/dist must be ignored too.
# The rest are root-only artifacts; anchoring keeps them from swallowing
# source directories that happen to share the name (e.g. src/cli/output/).
dist/
/build/
/out/
/output/
*.tsbuildinfo
.eslintcache
*.tgz

# Environment and site config
.env
.env.*
!.env.example
crisismode.yaml

# Credentials — never commit
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
kubeconfig
*.kubeconfig
.npmrc
.pgpass

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.idea/
.vscode/
.claude/settings.local.json
.claude/projects/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/

# Temp files
/tmp/
/temp/

# Local test data
test/local/.data/

# Internal product specs
specs/product/
eval/reports/
package-lock.json

# Session memory files and check artifacts (never commit)
memory/
checks/**/sh-thd-*
